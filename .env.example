# 复制本文件为 .env 后填写真实密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=此处填写 MySQL 密码
DB_NAME=smart_medbox

# ============================================================
# JWT 签名密钥（必填，且每台部署环境应当不同）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 泄露后果：任何人都能伪造任意身份的令牌，等同于全盘失守
# ============================================================
JWT_SECRET=替换为自行生成的随机字符串

# 令牌有效期（可选，以下为默认值）
JWT_ACCESS_TTL=2h      # 子女端访问令牌
JWT_REFRESH_TTL=30d    # 刷新令牌（存 httpOnly Cookie）
JWT_DEVICE_TTL=180d    # 药箱设备令牌

# bcrypt 计算强度（可选，默认 10；生产建议 12，越高越慢越安全）
BCRYPT_COST=10

# 全局限流：单 IP 每分钟请求上限
RATE_LIMIT_MAX=300

# ============================================================
# AI 大模型（可选，OpenAI 兼容协议）
# 不填也能跑：问答会自动回退到内置规则引擎。
# 想接真模型，填 LLM_API_KEY 即可，详见 docs/LLM_SETUP.md
# ============================================================
LLM_API_KEY=              # 大模型 API Key（留空=使用规则引擎）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus       # 可换 qwen-turbo / qwen-max / deepseek-chat 等
LLM_VISION_MODEL=qwen3-vl-plus  # 拍照识药用的视觉模型（旧址 qwen-vl-plus 已下线，可换 qwen-vl-max 等）
LLM_TIMEOUT=15000         # 调用超时（毫秒）

# ============================================================
# 反向代理（可选，仅在 nginx / 云负载均衡后面部署时需要）
# 不填则直接以 Node 对外提供服务（本机开发、局域网演示均如此）
# ============================================================
# TRUST_PROXY=1
# 对外域名：填了它之后，跨域白名单会额外放行该来源（逗号分隔可填多个）
# CORS_ORIGINS=https://your-domain.com
